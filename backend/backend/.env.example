APP_NAME=voice-interviewer
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

API_KEYS=dev-key-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

STORAGE_DIR=./data
DATABASE_PATH=./data/interviews.db
MODELS_CONFIG_PATH=./models.yaml

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS_PER_PROVIDER=1
PROVIDER_COOLDOWN_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.4

DEFAULT_QUESTION_COUNT=8
MAX_QUESTION_COUNT=15

WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=3

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
STT_MAX_UPLOAD_MB=25

PIPER_BINARY=piper
PIPER_MODEL_PATH=
PIPER_DEFAULT_VOICE=en_US-lessac-medium

# Security. Outside ENVIRONMENT=development the service refuses to start with the default
# key, keys shorter than 32 chars, or CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173.
# API_KEYS entries are "key" or "tenant:key"; each tenant only sees its own interviews.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
CALLBACK_ALLOWED_HOSTS=
CALLBACK_ALLOW_INSECURE=false
MAX_DOC_UPLOAD_MB=5
MAX_TEXT_CHARS=100000
MAX_TRANSCRIPT_CHARS=20000
MAX_METADATA_BYTES=16384

# Rate limits (per API key / tenant, in-process; also rate-limit at your gateway if running several workers)
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20
DAILY_EXPENSIVE_BUDGET=2000
AUTH_FAIL_LIMIT_PER_MINUTE=10

# Untrusted document parsing (runs in a child process with a hard timeout)
MAX_PDF_PAGES=30
MAX_DOCX_UNCOMPRESSED_MB=20
DOC_PARSE_TIMEOUT_SECONDS=20

# Prompt-injection hardening: LLM scores may differ from the heuristic baseline by at most this
SCORE_CLAMP_DELTA=25

# Candidate data handling
RETAIN_AUDIO=false
RETENTION_DAYS=0
RETENTION_SWEEP_MINUTES=60
LLM_DISABLED_PROVIDERS=
REQUIRE_CONSENT=false
