APP_NAME=voice-interviewer
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

API_KEYS=dev-key-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

STORAGE_DIR=./data
DATABASE_PATH=./data/interviews.db
MODELS_CONFIG_PATH=./models.yaml
PLANS_CONFIG_PATH=./plans.yaml

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DATA_COLLECTION=deny

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS_PER_PROVIDER=1
PROVIDER_COOLDOWN_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.4

DEFAULT_QUESTION_COUNT=8
MAX_QUESTION_COUNT=15

WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=3

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
STT_MAX_UPLOAD_MB=25

PIPER_BINARY=piper
PIPER_MODEL_PATH=
PIPER_DEFAULT_VOICE=en_US-lessac-medium

# Security. Outside ENVIRONMENT=development the service refuses to start with the default
# key, keys shorter than 32 chars, or CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173.
# API_KEYS entries are "key" or "tenant:key"; each tenant only sees its own interviews.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
CALLBACK_ALLOWED_HOSTS=
CALLBACK_ALLOW_INSECURE=false
MAX_DOC_UPLOAD_MB=5
MAX_TEXT_CHARS=100000
MAX_TRANSCRIPT_CHARS=4000
MAX_METADATA_BYTES=16384

# Rate limits (per API key / tenant, in-process; also rate-limit at your gateway if running several workers)
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20
DAILY_EXPENSIVE_BUDGET=2000
AUTH_FAIL_LIMIT_PER_MINUTE=10
# Per student (tenant + external_ref), same expensive calls. 0 = unlimited. Calls with no external_ref skip these.
STUDENT_RATE_LIMIT_PER_MINUTE=30
STUDENT_DAILY_BUDGET=200

# Untrusted document parsing (runs in a child process with a hard timeout)
MAX_PDF_PAGES=30
MAX_DOCX_UNCOMPRESSED_MB=20
DOC_PARSE_TIMEOUT_SECONDS=20

# Plans and purchased packs (see plans.yaml and models.yaml). Off by default.
# When on: every interview needs an external_ref (the student id) and a plan; the student must have an active pack
# for that plan (the main app records purchases with POST /api/v1/packs/activate); the interview's length is debited
# from the pack; each plan is served by its own model profile and AI-provider list; answers are refused after the
# server-side deadline. The service will not start if plans.yaml and models.yaml disagree.
PLANS_ENABLED=false
# Longest single answer. Also keep STT_MAX_UPLOAD_MB small (5 is plenty for three minutes of speech).
MAX_ANSWER_SECONDS=180

# Prompt-injection hardening: LLM scores may differ from the heuristic baseline by at most this
SCORE_CLAMP_DELTA=25

# Candidate data handling
RETAIN_AUDIO=false
# Delete interviews older than this many days (0 = keep forever). Set a number before going live.
RETENTION_DAYS=0
RETENTION_SWEEP_MINUTES=60
LLM_DISABLED_PROVIDERS=
# Remove names, contact details, links, addresses and visa/work-authorization lines from the copy of a resume or
# answer sent to an AI provider. Stored data is unchanged. Leave on.
REDACT_PII_FOR_LLM=true
REQUIRE_CONSENT=false

# Extra Piper voices callers may request (the default voice is always allowed)
PIPER_ALLOWED_VOICES=
# Outside development, webhooks are only sent when WEBHOOK_SECRET is set.

# Production database (Supabase transaction pooler) and shared limits (Upstash).
# Leave DATABASE_URL empty to use the local SQLite file above. See docs/DEPLOY_FLY_SUPABASE.md.
DATABASE_URL=
DB_SCHEMA=interviewer
DB_POOL_SIZE=5
DB_AUTO_MIGRATE=true
REDIS_URL=
REDIS_KEY_PREFIX=interviewer
